# Server-only secrets. Never commit the real .env file.
TAVILY_API_KEY=your_tavily_api_key
LOVABLE_API_KEY=your_lovable_ai_api_key
RESEND_API_KEY=your_resend_api_key
# Optional. If omitted, Resend's onboarding sender is used for testing.
RESEND_FROM=EventRadar <onboarding@resend.dev>

# Supabase server connection (generated by the project integration)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
